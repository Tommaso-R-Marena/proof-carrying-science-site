{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proof-carrying-science-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": {
      "enabled": true
    },
    "redact_query_string": true
  },
  "vars": {
    "ADMIN_EMAIL": "marenatommaso@gmail.com",
    "PUBLIC_ORIGIN": "https://proof-carrying-science-site.marenatommaso.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "COMMONS_DB",
      "database_name": "pcs-commons",
      "database_id": "9e5288c2-efef-4918-b029-7ef001b70064",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "previews": {
    "vars": {
      "PCS_PREVIEW": "true"
    },
    "d1_databases": []
  }
}
